---
import "../styles/global.css";
import TarjetaProyectos from "./TarjetaProyectos.astro";
import { getCollection } from "astro:content";
import SobreMi from "./SobreMi.astro";
import Contacto from "./Contacto.astro";
import Stack from "./Stack.astro";
import Experiencia from "./Experiencia.astro";

const TodosLosProyectos = await getCollection("proyectos");
---

<div
    class="space-y-6 container mx-auto text-center items-center justify-center text-center"
>
    <div
        class="container flex flex-col md:flex-row justify-center items-stretch mx-auto gap-8 my-2 px-4 border-b border-gray-200"
    >
        <div
            class="w-full md:w-1/3 bg-white rounded-lg flex flex-col justify-center items-center text-center p-6 mx-auto"
        >
            <p class="bungee-regular text-3xl lg:text-4xl leading-tight mb-2">
                Edinson Arley Amaya Ariza
            </p>
            <h1 class="bungee-regular text-xl text-blue-600 leading-tight">
                Ingeniero De Sistemas | Full Stack Developer.
            </h1>
        </div>

        <SobreMi />

    </div>

    <div
        class="container flex flex-col md:flex-row items-stretch mx-auto gap-8"
    >
        <Contacto />

        <div class="md:w-5/6 bg-white rounded-lg flex flex-col text-center p-8">
            
            <Stack />

            <Experiencia />

            <div>
                <p
                    class="bungee-regular text-xl md:text-2xl text-blue-400 uppercase tracking-widest font-semibold mb-8"
                >
                    Proyectos Personales
                </p>
            </div>

            <div class="max-w-7xl mx-auto px-4">
                <div
                    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
                >
                    {
                        TodosLosProyectos.map((proyecto: any) => (
                            <div class="flex h-full">
                                <TarjetaProyectos
                                    titulo={proyecto.data.titulo}
                                    descripcion={proyecto.data.descripcion}
                                    imagen={proyecto.data.imagen}
                                    urlRepositorio={
                                        proyecto.data.urlRepositorio
                                    }
                                    etiquetas={proyecto.data.etiquetas}
                                />
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</div>
