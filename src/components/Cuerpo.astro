---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import Hero from "./Hero.astro";
import SobreMi from "./SobreMi.astro";
import Stack from "./Stack.astro";
import Experiencia from "./Experiencia.astro";
import TarjetaProyectos from "./TarjetaProyectos.astro";
import Email from "./Email.astro";

const proyectos = await getCollection("proyectos");
---

<Hero />
<SobreMi />
<Stack />
<Experiencia />

<section id="proyectos" class="section border-line/70 border-t">
	<div class="container-page">
		<div class="reveal flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
			<div class="max-w-2xl">
				<p class="eyebrow">Portafolio</p>
				<h2 class="text-ink mt-4 text-3xl font-semibold sm:text-4xl">Proyectos destacados</h2>
				<p class="text-muted mt-4 leading-relaxed">
					Una selección de proyectos donde aplico backend, ciencia de datos y desarrollo web de
					extremo a extremo.
				</p>
			</div>

			<a
				href="https://github.com/EdinsonAmaya"
				target="_blank"
				rel="noopener noreferrer"
				class="text-muted hover:text-accent inline-flex shrink-0 items-center gap-2 text-sm font-medium transition-colors"
			>
				Ver todo en GitHub
				<Icon name="ph:arrow-up-right-bold" class="text-base" />
			</a>
		</div>

		<div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
			{
				proyectos.map((proyecto, index) => (
					<div class="reveal h-full" style={`--reveal-delay: ${index * 80}ms`}>
						<TarjetaProyectos
							titulo={proyecto.data.titulo}
							descripcion={proyecto.data.descripcion}
							imagen={proyecto.data.imagen}
							urlRepositorio={proyecto.data.urlRepositorio}
							etiquetas={proyecto.data.etiquetas}
						/>
					</div>
				))
			}
		</div>
	</div>
</section>

<Email />
