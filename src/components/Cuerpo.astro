---
import "../styles/global.css";
import TarjetaProyectos from "./TarjetaProyectos.astro";
import { getCollection } from "astro:content";
import SobreMi from "./SobreMi.astro";
import Stack from "./Stack.astro";
import Experiencia from "./Experiencia.astro";
import { Icon } from "astro-icon/components";
import Email from "./Email.astro";
import Footer from "./Footer.astro";

const TodosLosProyectos = await getCollection("proyectos");
---

<div class="container mx-auto items-center justify-center space-y-6 text-center">
	<div
		class="container mx-auto my-2 flex flex-col items-stretch justify-center gap-8 border-b border-gray-200 px-4"
	>
		<div
			class="mx-auto flex w-full flex-col items-center justify-center rounded-3xl bg-white/5 p-6 text-center shadow-[0_25px_80px_rgba(15,23,42,0.25)] backdrop-blur-xl md:w-1/3"
		>
			<img
				src="/ea-icon.png"
				alt="Edinson Amaya Desarrollador Full Stack"
				class="mx-auto mb-6 h-40 w-auto object-cover shadow-[0_20px_60px_rgba(37,99,235,0.3)] transition duration-500 hover:-translate-y-1"
			/>
			<p
				class="bungee-regular mb-3 text-5xl text-white drop-shadow-[0_0_15px_rgba(37,99,235,0.6)] sm:text-5xl lg:text-6xl"
			>
				Edinson Arley Amaya Ariza
			</p>
			<h1
				class="inline-block rounded-full border border-blue-500/20 bg-blue-950/30 px-4 py-1 font-mono text-blue-300/80 sm:text-base md:text-base lg:text-base"
			>
				Ingeniero De Sistemas | Full Stack Developer.
			</h1>
			<div class="mt-4 flex flex-wrap items-center justify-center gap-3 gap-4">
				<div class="mt-4 inline-block">
					<a
						href="https://www.linkedin.com/in/edinson-amaya-ariza-47a1ab27a/"
						target="_blank"
						rel="noopener noreferrer"
						class="group flex items-center justify-center gap-3 rounded-xl border-2 border-slate-200 bg-white px-6 py-2 transition-all duration-300 hover:-translate-y-1 hover:border-blue-600 hover:shadow-md"
					>
						<i
							class="devicon-linkedin-plain colored text-2xl transition-transform group-hover:scale-110"
						></i>

						<span class="font-semibold text-slate-700 group-hover:text-blue-600"> LinkedIn </span>
					</a>
				</div>
				<div class="mt-4 inline-block">
					<a
						href="https://github.com/edinsonamayaariza"
						target="_blank"
						rel="noopener noreferrer"
						class="group flex items-center justify-center gap-3 rounded-xl border-2 border-slate-200 bg-white px-6 py-2 transition-all duration-300 hover:-translate-y-1 hover:border-blue-600 hover:shadow-md"
					>
						<i
							class="devicon-github-original colored text-2xl transition-transform group-hover:scale-110"
						></i>

						<span class="font-semibold text-slate-700 group-hover:text-blue-600"> GitHub </span>
					</a>
				</div>
				<div class="mt-4 inline-block">
					<a
						href="/CV_Edinson_Amaya_Ing_Sistemas.pdf"
						download="CV_Edinson_Amaya_Ing_Sistemas.pdf"
						rel="noopener noreferrer"
						class="group flex items-center justify-center gap-3 rounded-xl border-2 border-slate-200 bg-white px-6 py-2 transition-all duration-300 hover:-translate-y-1 hover:border-blue-600 hover:shadow-md"
					>
						<Icon name="ph:file-text-bold" class="text-2xl text-black" />
						<span class="font-semibold text-slate-700 group-hover:text-blue-600"> CV </span>
					</a>
				</div>
			</div>
		</div>

		<SobreMi />
	</div>

	<div class="">
		<div class="flex flex-col rounded-lg bg-white p-8 text-center">
			<Stack />

			<Experiencia />

			<div>
				<p
					class="bungee-regular mb-8 text-xl font-semibold tracking-widest text-blue-400 uppercase md:text-2xl"
				>
					Proyectos Personales
				</p>
			</div>

			<div class="mx-auto max-w-7xl px-4">
				<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{
						TodosLosProyectos.map((proyecto: any) => (
							<div class="flex h-full">
								<TarjetaProyectos
									titulo={proyecto.data.titulo}
									descripcion={proyecto.data.descripcion}
									imagen={proyecto.data.imagen}
									urlRepositorio={proyecto.data.urlRepositorio}
									etiquetas={proyecto.data.etiquetas}
								/>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</div>
	<div>
		<p
			class="bungee-regular mb-8 text-xl font-semibold tracking-widest text-blue-400 uppercase md:text-2xl"
		>
			Contactame.
		</p>
		<Email />
	</div>
</div>
