---
import { Icon } from "astro-icon/components";

interface Props {
	titulo: string;
	descripcion: string;
	imagen: string;
	urlRepositorio: string;
	etiquetas?: string[];
}

const { titulo, descripcion, imagen, urlRepositorio, etiquetas = [] } = Astro.props;
---

<article
	class="card hover:border-accent/40 hover:bg-surface-2/60 group flex h-full flex-col overflow-hidden hover:-translate-y-1 hover:shadow-[0_24px_50px_-30px_rgba(2,6,23,0.9)]"
>
	<div class="border-line relative aspect-video overflow-hidden border-b bg-slate-100">
		<img
			src={imagen}
			alt={`Captura del proyecto ${titulo}`}
			loading="lazy"
			decoding="async"
			class="h-full w-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-[1.03]"
		/>
	</div>

	<div class="flex flex-1 flex-col p-5">
		{
			etiquetas.length > 0 && (
				<ul class="flex flex-wrap gap-1.5">
					{etiquetas.slice(0, 4).map((etiqueta) => (
						<li class="border-accent/15 bg-accent/10 text-accent-soft rounded-full border px-2.5 py-0.5 text-[11px] font-medium">
							{etiqueta}
						</li>
					))}
				</ul>
			)
		}

		<h3 class="text-ink mt-3 text-base leading-snug font-semibold">{titulo}</h3>
		<p class="text-muted mt-2 flex-1 text-sm leading-relaxed">{descripcion}</p>

		<div class="border-line mt-5 border-t pt-4">
			<a
				href={urlRepositorio}
				target="_blank"
				rel="noopener noreferrer"
				class="text-ink/80 hover:text-accent flex items-center justify-between gap-2 text-sm font-medium transition-colors"
			>
				<span class="inline-flex items-center gap-2">
					<Icon name="ph:github-logo-bold" class="text-base" />
					Ver repositorio
				</span>
				<Icon
					name="ph:arrow-up-right-bold"
					class="text-base transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
				/>
			</a>
		</div>
	</div>
</article>
