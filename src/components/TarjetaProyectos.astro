---
const { titulo, descripcion, imagen, urlRepositorio, etiquetas } = Astro.props;

import "../styles/global.css";
---

<div
    class="flex flex-col h-full bg-white rounded-xl overflow-hidden shadow-md border border-gray-200"
>
    <div class="w-full">
        <img
            src={imagen}
            alt={titulo}
            class="w-full h-auto min-h-[200px] object-top object-cover"
        />
    </div>

    <div class="flex flex-col flex-grow p-4">
        <h3
            class="bungee-regular text-xl md:text-lg text-blue-400 uppercase tracking-widest font-semibold"
        >
            {titulo}
        </h3>
        <p class="text-gray-600 text-sm flex-grow">{descripcion}</p>

        <div class="mt-4 pt-4 border-t text-center justify-center mx-auto">
            <a
                href={urlRepositorio}
                target="_blank"
                class="text-blue-600 font-semibold flex items-center gap-2"
            >
                <i class="bi bi-github"></i> GitHub
            </a>
        </div>
    </div>
</div>
