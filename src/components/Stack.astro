---
const tecnologias = [
	{ nombre: "Python", rol: "Backend y datos", icono: "devicon-python-plain colored" },
	{ nombre: "Java", rol: "Backend", icono: "devicon-java-plain colored" },
	{ nombre: "Spring Boot", rol: "APIs REST", icono: "devicon-spring-plain colored" },
	{ nombre: "JavaScript", rol: "Frontend", icono: "devicon-javascript-plain colored" },
	{ nombre: "Azure SQL", rol: "Bases de datos", icono: "devicon-azuresqldatabase-plain colored" },
	{ nombre: "Postman", rol: "Testing de APIs", icono: "devicon-postman-plain colored" },
	{ nombre: "GitHub", rol: "Versionamiento", icono: "devicon-github-original colored" },
];
---

<section id="stack" class="section border-line/70 border-t">
	<div class="container-page">
		<div class="reveal max-w-2xl">
			<p class="eyebrow">Stack</p>
			<h2 class="text-ink mt-4 text-3xl font-semibold sm:text-4xl">Core stack & especialidades</h2>
			<p class="text-muted mt-4 leading-relaxed">
				Desarrollo integral con dominio de Java y Python para arquitecturas de backend, interfaces
				dinámicas con JavaScript y bases de datos sólidas. Mi trabajo se apoya en Clean Architecture
				para construir sistemas mantenibles y de alto rendimiento.
			</p>
		</div>

		<ul class="mt-10 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
			{
				tecnologias.map((tecnologia, index) => (
					<li
						class="card hover:border-accent/40 hover:bg-surface-2/70 group reveal flex items-center gap-3 p-4 hover:-translate-y-0.5"
						style={`--reveal-delay: ${index * 50}ms`}
					>
						<span class="bg-base/60 border-line flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border">
							<i
								class={`${tecnologia.icono} text-2xl transition-transform group-hover:scale-110`}
							/>
						</span>
						<span>
							<span class="text-ink block text-sm font-semibold">{tecnologia.nombre}</span>
							<span class="text-subtle block text-xs">{tecnologia.rol}</span>
						</span>
					</li>
				))
			}
		</ul>
	</div>
</section>
