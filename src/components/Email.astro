---
import { Icon } from "astro-icon/components";
---

<section id="contacto" class="section border-line/70 border-t">
	<div class="container-page grid gap-12 lg:grid-cols-[0.85fr_1.15fr]">
		<div class="reveal">
			<p class="eyebrow">Contacto</p>
			<h2 class="text-ink mt-4 text-3xl font-semibold sm:text-4xl">Hablemos de tu proyecto</h2>
			<p class="text-muted mt-4 max-w-md leading-relaxed">
				Estoy disponible para colaboraciones, proyectos freelance y oportunidades remotas. Cuéntame
				qué necesitas y te responderé lo antes posible.
			</p>

			<ul class="mt-8 space-y-3">
				<li class="text-muted flex items-center gap-3 text-sm">
					<span
						class="bg-accent/10 text-accent flex h-9 w-9 items-center justify-center rounded-full"
					>
						<Icon name="ph:map-pin-bold" class="text-base" />
					</span>
					Bucaramanga, Colombia
				</li>
				<li class="text-muted flex items-center gap-3 text-sm">
					<span
						class="bg-accent/10 text-accent flex h-9 w-9 items-center justify-center rounded-full"
					>
						<Icon name="ph:linkedin-logo-bold" class="text-base" />
					</span>
					<a
						href="https://www.linkedin.com/in/edinson-amaya-ariza-47a1ab27a/"
						target="_blank"
						rel="noopener noreferrer"
						class="hover:text-accent transition-colors"
					>
						linkedin.com/in/edinson-amaya-ariza
					</a>
				</li>
				<li class="text-muted flex items-center gap-3 text-sm">
					<span
						class="bg-accent/10 text-accent flex h-9 w-9 items-center justify-center rounded-full"
					>
						<Icon name="ph:github-logo-bold" class="text-base" />
					</span>
					<a
						href="https://github.com/EdinsonAmaya"
						target="_blank"
						rel="noopener noreferrer"
						class="hover:text-accent transition-colors"
					>
						github.com/EdinsonAmaya
					</a>
				</li>
			</ul>
		</div>

		<div class="reveal" style="--reveal-delay: 100ms">
			<form
				class="surface rounded-2xl border-white/10 bg-white/[0.03] p-6 shadow-[0_28px_80px_-40px_rgba(2,6,23,0.9)] backdrop-blur-xl sm:p-8"
				id="email-form"
			>
				<div class="space-y-5">
					<div class="space-y-2 text-left">
						<label
							for="name"
							class="text-muted block text-xs font-semibold tracking-[0.14em] uppercase"
						>
							Nombre
						</label>
						<input
							type="text"
							id="name"
							name="name"
							required
							autocomplete="name"
							placeholder="Tu nombre"
							class="border-line-strong bg-base/60 text-ink placeholder:text-subtle focus:border-accent focus:ring-accent/25 w-full rounded-xl border px-4 py-3 text-sm transition outline-none focus:ring-2"
						/>
					</div>

					<div class="space-y-2 text-left">
						<label
							for="email"
							class="text-muted block text-xs font-semibold tracking-[0.14em] uppercase"
						>
							Email
						</label>
						<input
							type="email"
							id="email"
							name="email"
							required
							autocomplete="email"
							placeholder="tu@email.com"
							class="border-line-strong bg-base/60 text-ink placeholder:text-subtle focus:border-accent focus:ring-accent/25 w-full rounded-xl border px-4 py-3 text-sm transition outline-none focus:ring-2"
						/>
					</div>

					<div class="space-y-2 text-left">
						<label
							for="message"
							class="text-muted block text-xs font-semibold tracking-[0.14em] uppercase"
						>
							Mensaje
						</label>
						<textarea
							id="message"
							name="message"
							rows="5"
							required
							placeholder="Cuéntame brevemente sobre tu proyecto o propuesta."
							class="border-line-strong bg-base/60 text-ink placeholder:text-subtle focus:border-accent focus:ring-accent/25 min-h-[140px] w-full resize-y rounded-xl border px-4 py-3 text-sm transition outline-none focus:ring-2"
						></textarea>
					</div>

					<div class="hidden" aria-hidden="true">
						<label for="_gotcha">No completar este campo</label>
						<input type="text" id="_gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
					</div>

					<button
						type="submit"
						class="btn btn-primary w-full disabled:cursor-not-allowed disabled:opacity-60"
					>
						<Icon name="ph:paper-plane-tilt-bold" class="text-base" data-submit-icon />
						<span data-submit-label>Enviar mensaje</span>
					</button>

					<p
						id="form-status"
						role="status"
						aria-live="polite"
						class="hidden text-center text-sm font-medium"
					>
					</p>
				</div>
			</form>
		</div>
	</div>
</section>

<script>
	const form = document.getElementById("email-form") as HTMLFormElement | null;
	const status = document.getElementById("form-status");
	const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
	const submitLabel = form?.querySelector<HTMLElement>("[data-submit-label]");

	const showStatus = (type: "success" | "error", message: string) => {
		if (!status) return;
		status.textContent = message;
		status.classList.remove("hidden", "text-emerald-300", "text-red-300");
		status.classList.add(type === "success" ? "text-emerald-300" : "text-red-300");
	};

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		if (!form || !submitButton) return;

		const originalLabel = submitLabel?.textContent ?? "Enviar mensaje";
		submitButton.disabled = true;
		if (submitLabel) submitLabel.textContent = "Enviando…";

		try {
			const response = await fetch("https://formspree.io/f/xdabkkaj", {
				method: "POST",
				body: new FormData(form),
				headers: { Accept: "application/json" },
			});

			if (response.ok) {
				showStatus("success", "¡Gracias! Tu mensaje se envió correctamente.");
				form.reset();
			} else {
				showStatus("error", "No pudimos enviar el mensaje. Inténtalo de nuevo.");
			}
		} catch {
			showStatus("error", "Hubo un problema de conexión. Revisa tu red e inténtalo otra vez.");
		} finally {
			submitButton.disabled = false;
			if (submitLabel) submitLabel.textContent = originalLabel;
		}
	});
</script>
