---

---

<form
	class="email-form mx-auto max-w-xl rounded-[2rem] border border-slate-700/70 bg-slate-950/90 p-8 shadow-[0_28px_80px_rgba(15,23,42,0.45)] backdrop-blur-xl"
	id="email-form"
>
	<div class="space-y-6">
		<div class="space-y-3 text-left">
			<label
				for="subject"
				class="block text-sm font-semibold tracking-[0.12em] text-slate-400 uppercase"
			>
				Nombre
			</label>
			<input
				type="text"
				id="name"
				name="name"
				required
				class="w-full rounded-3xl border border-slate-700/80 bg-slate-950/80 px-4 py-3 text-slate-100 transition duration-300 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/25"
			/>
		</div>

		<div class="space-y-3 text-left">
			<label
				for="email"
				class="block text-sm font-semibold tracking-[0.12em] text-slate-400 uppercase"
			>
				Email
			</label>
			<input
				type="email"
				id="email"
				name="email"
				required
				class="w-full rounded-3xl border border-slate-700/80 bg-slate-950/80 px-4 py-3 text-slate-100 transition duration-300 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/25"
			/>
		</div>

		<div class="space-y-3 text-left">
			<label
				for="message"
				class="block text-sm font-semibold tracking-[0.12em] text-slate-400 uppercase"
			>
				Mensaje
			</label>
			<textarea
				id="message"
				name="message"
				rows="6"
				required
				class="min-h-[160px] w-full rounded-3xl border border-slate-700/80 bg-slate-950/80 px-4 py-3 text-slate-100 transition duration-300 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/25"
			></textarea>
		</div>

		<button
			type="submit"
			class="inline-flex w-full justify-center rounded-3xl bg-blue-500 px-6 py-3 text-base font-semibold text-white transition duration-300 hover:bg-blue-400 hover:shadow-xl focus:ring-4 focus:ring-blue-500/20 focus:outline-none"
		>
			Enviar
		</button>
	</div>
</form>

<script>
	const formulario = document.getElementById("email-form")! as HTMLFormElement | null;

	formulario?.addEventListener("submit", async (e) => {
		e.preventDefault(); // Evita que la página se recargue

		const data = new FormData(formulario);
		const response = await fetch("https://formspree.io/f/xdabkkaj", {
			method: "POST",
			body: data,
			headers: {
				Accept: "application/json",
			},
		});

		if (response.ok) {
			alert("¡Gracias! Mensaje enviado.");
			formulario?.reset();
		} else {
			alert("Hubo un error al enviar.");
		}
	});
</script>
